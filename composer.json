{
    "name": "infotelglpi/mydashboard",
    "type": "glpi-plugin",
    "description": "My Dashboard plugin for GLPI",
    "homepage": "https://github.com/InfotelGLPI/mydashboard",
    "license": "GPL-3.0-or-later",
    "authors": [
        {
            "name": "Infotel"
        }
    ],
    "require": {
        "php": ">=8.2"
    },
    "autoload": {
        "psr-4": {
            "GlpiPlugin\\Mydashboard\\": "src/"
        }
    },
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true,
        "platform": {
            "php": "8.2.99"
        }
    },
    "scripts": {
        "lint": "../../vendor/bin/parallel-lint --exclude vendor --exclude node_modules .",
        "cs": "../../vendor/bin/php-cs-fixer fix --dry-run --diff --ansi",
        "cs-fix": "../../vendor/bin/php-cs-fixer fix --ansi",
        "phpstan": "../../vendor/bin/phpstan analyze --ansi --memory-limit=1G",
        "qa": [
            "@lint",
            "@phpstan",
            "@cs"
        ]
    }
}

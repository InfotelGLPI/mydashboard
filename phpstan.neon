includes:
    - ../../vendor/glpi-project/phpstan-glpi/extension.neon
    - phpstan-baseline.neon

parameters:
    level: 5
    paths:
        - ajax
        - front
        - install
        - src
        - hook.php
        - setup.php
    excludePaths:
        # Untracked local-only report, absent on the CI runner: the (?) marker
        # keeps PHPStan from failing when the path does not exist.
        - src/Reports/Urgo.php (?)
    scanDirectories:
        - ../../inc
        - ../../src
    bootstrapFiles:
        - ../../stubs/glpi_constants.php
        - ../../vendor/autoload.php
        - setup.php
    treatPhpDocTypesAsCertain: false
    # The CI runner analyzes a pristine GLPI 11.0.x core while the local tree may
    # carry core modifications, so PHPStan's type narrowing differs between the two.
    # Tolerate baseline entries that do not reproduce on the runner (and vice versa).
    reportUnmatchedIgnoredErrors: false
    ignoreErrors:
        # CI-only finding: $itemtype is the literal "TicketTask", so the runner narrows
        # the dead `elseif ($itemtype == "ProblemTask")` branches to *NEVER*. The
        # matching `== 'TicketTask'` alwaysTrue is already accepted in the baseline;
        # this is its alwaysFalse counterpart, harmless locally thanks to the flag above.
        -
            message: '#^Loose comparison using \=\= between \*NEVER\* and ''ProblemTask'' will always evaluate to false\.$#'
            identifier: equal.alwaysFalse
            path: src/Reports/Ticket.php

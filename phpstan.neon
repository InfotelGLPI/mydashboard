includes:
    - ../../vendor/glpi-project/phpstan-glpi/extension.neon
    - phpstan-baseline.neon

parameters:
    level: 5
    paths:
        - ajax
        - front
        - install
        - src
        - hook.php
        - setup.php
    excludePaths:
        # Untracked local-only report, absent on the CI runner: the (?) marker
        # keeps PHPStan from failing when the path does not exist.
        - src/Reports/Urgo.php (?)
    scanDirectories:
        - ../../inc
        - ../../src
    bootstrapFiles:
        - ../../stubs/glpi_constants.php
        - ../../vendor/autoload.php
        - setup.php
    treatPhpDocTypesAsCertain: false

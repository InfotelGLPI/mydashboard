{# Row of counter tiles shared by the ticket-alert and SLA-alert widgets. A tile is only
   a link when its counter is above zero. #}
<div class="tickets-stats">
    {% for tile in tiles %}
        <div class="nb" style="color:{{ tile.color }}">
            {% if tile.url %}
                <a style="color:{{ tile.color }}" target="_blank" href="{{ tile.url }}"
                   {%- if tile.title %} title="{{ tile.title }}"{% endif %}>
            {% endif %}

            <i style="color:{{ tile.color }};{{ tile.icon_style }}" class="{{ tile.icon_class }}"></i>
            <h3 style="{{ tile.heading_style }}">
                <span class="counter count-number" id="{{ tile.id }}"></span>
            </h3>
            <p class="count-text ">{{ tile.label }}</p>

            {% if tile.url %}
                </a>
            {% endif %}
        </div>
    {% endfor %}

    {{ countup_script_html|raw }}
</div>

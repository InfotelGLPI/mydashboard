{# raw: criteria bar and chart container rendered by graph_header.html.twig (Helper::getGraphHeader()) #}
{{ header_html|raw }}

<div id="indicators" class="tickets-ind" style="text-align: center;">
    {% for cell in cells %}
        <div class="{{ cell.class }}">
            <a target="_blank" style="{{ cell.link.style }}" title="{{ cell.link.title }}" href="{{ cell.link.url }}">
                <span class="ind-link">{{ cell.link.count }}</span>
            </a>
            <br><br>
            {{ cell.label }}
        </div>
    {% endfor %}
</div>

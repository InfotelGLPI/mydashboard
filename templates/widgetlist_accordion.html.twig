{# Two nested Bootstrap accordions: widget families, then widget types. #}
<div class="accordion" id="{{ accordion_id }}">
    {% for category in categories %}
        <div class="accordion-item">
            <h2 class="accordion-header" id="hd-{{ category.id }}">
                <button class="accordion-button collapsed" type="button"
                        data-bs-toggle="collapse" data-bs-target="#body-{{ category.id }}"
                        aria-expanded="false" aria-controls="body-{{ category.id }}">
                    <i class="{{ category.icon }} me-2"></i>{{ category.label }}
                </button>
            </h2>
            <div id="body-{{ category.id }}" class="accordion-collapse collapse"
                 aria-labelledby="hd-{{ category.id }}" data-bs-parent="#{{ accordion_id }}">
                <div class="accordion-body p-0">
                    {% for group in category.groups %}
                        <div class="accordion" id="{{ group.id }}-acc">
                            <div class="accordion-item border-0 border-top">
                                <h2 class="accordion-header">
                                    <button class="accordion-button collapsed ps-4 py-2" type="button"
                                            data-bs-toggle="collapse" data-bs-target="#{{ group.id }}"
                                            aria-expanded="false">
                                        <i class="{{ group.icon }} me-2"></i>{{ group.label }}
                                    </button>
                                </h2>
                                <div id="{{ group.id }}" class="accordion-collapse collapse">
                                    <div class="accordion-body p-0">
                                        <div class="list-group list-group-flush">
                                            {% include '@mydashboard/widgetlist_items.html.twig' with {'items': group.items} only %}
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    {% endfor %}
                </div>
            </div>
        </div>
    {% endfor %}
</div>

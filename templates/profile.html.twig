{% if canedit %}
    <form method="post" action="{{ form_action }}">
{% endif %}

<table class="tab_cadre_fixehov">
    <tr class="tab_bg_2">
        <th colspan="4" class="center b">{{ title }}</th>
    </tr>
    <tr class="tab_bg_1">
        <td></td>
        <td>{{ __('Full', 'mydashboard') }}</td>
        <td>{{ __('Custom', 'mydashboard') }}</td>
    </tr>
    {% for row in rows %}
        <tr class="tab_bg_2">
            <td>{{ row.label }}</td>
            <td>{{ row.full_html|raw }}</td>
            <td>{%- if row.custom_html %}{{ row.custom_html|raw }}{% endif -%}</td>
        </tr>
    {% endfor %}
</table>

{{ rights_matrix_html|raw }}

{% if canedit and closeform %}
    <div class="center">
        {{ hidden_html|raw }}
        {{ submit_html|raw }}
    </div>
    {# closes the <form> above and carries the CSRF token #}
    {{ close_form_html|raw }}
{% endif %}

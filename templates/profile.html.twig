{% import 'components/form/fields_macros.html.twig' as fields %}
{% import 'components/form/basic_inputs_macros.html.twig' as inputs %}

{% if canedit %}
    <form method="post" action="{{ profile.getFormURL() }}">
        {{ fields.hiddenField('id', profile.getID()) }}
{% endif %}

<table class="tab_cadre_fixehov">
    <tr class="tab_bg_2">
        <th colspan="4" class="center b">{{ title }}</th>
    </tr>
    <tr class="tab_bg_1">
        <td></td>
        <td>{{ __('Full', 'mydashboard') }}</td>
        <td>{{ __('Custom', 'mydashboard') }}</td>
    </tr>
    {% for row in rows %}
        <tr class="tab_bg_2">
            <td>{{ row.label }}</td>
            <td>{{ inputs.checkbox(row.full.name, row.full.checked ? 1 : 0) }}</td>
            <td>
                {%- if row.custom is not null %}{{ inputs.checkbox(row.custom.name, row.custom.checked ? 1 : 0) }}{% endif -%}
            </td>
        </tr>
    {% endfor %}
</table>

{% do profile.displayRightsChoiceMatrix(rights, {
    'canedit': canedit,
    'default_class': 'tab_bg_2',
    'title': __('Setup stock widget', 'mydashboard'),
}) %}

{% if canedit %}
    {% if closeform %}
        <div class="text-center">
            {{ inputs.submit('update', _x('button', 'Save'), 1, {'class': 'btn btn-primary'}) }}
        </div>
    {% endif %}
    </form>
{% endif %}

{# GLPI status banner: maintenance mode uses the "center" class, the three probe
   outcomes use "md-title-status". #}
<div class="{{ wrapper_class }}" style="color:{{ color }}">
    <i class="{{ icon }}" style="font-size:4em"></i>
    <br><br>
    <b>{{ label }}</b>
    {%- if url %}
        <br><br><a href="{{ url }}" target="_blank">{{ url }}</a>
    {% endif -%}
</div>

{% if maintenance_text is not empty %}
    <div class="md-status">
        {# already passed through nl2br() by the controller #}
        <p>{{ maintenance_text|raw }}</p>
    </div>
{% endif %}

{# Same shape as criteria_filter_date: a mode selector, then a block refreshed in place
   by the AJAX call below. #}
<span class="md-widgetcrit">{{ __('Display', 'mydashboard') }}&nbsp;{{ mode_html|raw }}</span>

{% if start_end %}
    {% include '@mydashboard/criteria_period_fields.html.twig' with {'rand': rand, 'fields': fields} only %}
{% else %}
    <br><br>
    <span id="display_data_crit{{ rand }}" name="display_data_crit{{ rand }}" class="md-widgetcrit">
        {{ __('Year', 'mydashboard') }}&nbsp;{{ year_html|raw }}
    </span>
{% endif %}

{{ ajax_html|raw }}
{%- if count > 1 %}<br><br>{% endif -%}

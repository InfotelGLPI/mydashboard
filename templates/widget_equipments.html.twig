{% if fromsc %}
    <div class="bt-feature {{ feature_class }}">
        <h3>
            <div class="alert alert-light " role="alert">{{ __('Your equipments', 'mydashboard') }}</div>
        </h3>
    </div>
{% endif %}

{% if not groups|length %}
    <div class="bt-feature bt-col-md-11 equip-item center">
        <h3><span class="alert-color">{{ __('No equipments founded', 'mydashboard') }}</span></h3>
    </div>
{% else %}
    {% if fromsc %}
        <div class="bt-feature bt-col-md-12 count-title">
    {% endif %}

    {% for group in groups %}
        <div class="bt-feature bt-col-md-3 center equip-text {{ group.class }}">
            {% for item in group.items %}
                <div class="equip-item">
                    <br>
                    {% if item.url %}<a href="{{ item.url }}" target="_blank">{% endif %}
                        <i class="{{ item.icon }} fa-2x fa-border"></i>
                        <br>
                        {{ item.name }}
                    {% if item.url %}</a>{% endif %}
                    <br>
                    {{ item.typename }}
                    <br>
                </div>
            {% endfor %}
        </div>
    {% endfor %}

    {% if fromsc %}
        </div>
    {% endif %}
{% endif %}

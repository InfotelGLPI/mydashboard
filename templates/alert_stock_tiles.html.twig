<div class="tickets-stats">
    {% if not tiles|length %}
        <i style="font-size:3em;color:orange" class="ti ti-alert-triangle"></i>
        <br><br>
        <span class="b">{{ __('No alerts are setup', 'mydashboard') }}</span>
    {% else %}
        {% for tile in tiles %}
            <div class="nbstock" style="color:{{ tile.color }}">
                <a style="color:{{ tile.color }}" target="_blank" href="{{ tile.url }}" title="{{ tile.name }}">
                    <i style="color:{{ tile.color }};font-size:3em;" class="ti {{ tile.icon }} fa-border"></i>
                    <h3 style="margin-top: 10px;">
                        <span class="counter count-number" id="{{ tile.id }}"></span>
                    </h3>
                    <p class="count-text ">{{ tile.name }}</p>
                </a>
            </div>
        {% endfor %}
        {{ countup_script_html|raw }}
    {% endif %}
</div>

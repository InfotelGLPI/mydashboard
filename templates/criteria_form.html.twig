{# Summary line of the active criteria; clicking it toggles the panel below.
 # Every label and value below is stored raw by GLPI, so they are printed as data and
 # escaped by Twig: the separators are the only markup this line carries. #}
{% import 'components/form/basic_inputs_macros.html.twig' as inputs %}

<div id="plugin_mydashboard_add_criteria{{ rand }}" style="margin-bottom: 15px;"
     data-md-criteria-toggle="plugin_mydashboard_see_criteria{{ rand }}">
    <i class="ti ti-adjustments"></i>
    <span style="font-size: 12px;font-family: verdana,serif;color: #CCC;font-weight: bold;">
        {%- for criterion in summary -%}
            {%- if not loop.first %}&nbsp;/{% endif -%}
            &nbsp;{{ criterion.label }}&nbsp;:&nbsp;
            {%- for value in criterion.values -%}
                {{ value }}{% if not loop.last %}&nbsp;-&nbsp;{% endif %}
            {%- endfor -%}
        {%- endfor -%}
    </span>
</div>

{# The panel toggle and the refresh of the widget are handled by
   public/scripts/criteria-form.js (loaded on every page by the ADD_JAVASCRIPT_MODULE hook,
   since other plugins render these forms too). #}
<div class="plugin_mydashboard_menuWidget" id="plugin_mydashboard_see_criteria{{ rand }}">
    <form id="{{ form_id }}" action="" data-md-criteria-form
          data-widget-id="{{ widget_id }}" data-gsid="{{ gsid }}"
          data-refresh-on="{{ on_submit ? 'submit' : 'change' }}">
        {# raw: concatenation of the Criterias\*::getDisplayForm() fragments, each one rendered
           by a template of its own (escaped values, core widgets). #}
        {{ fields_html|raw }}
        {%- if on_submit %}{{ inputs.submit('submit', _x('button', 'Send'), 1, {'class': 'btn btn-primary'}) }}{% endif %}
    </form>
</div>

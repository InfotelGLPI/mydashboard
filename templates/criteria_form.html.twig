{# Summary line of the active criteria; clicking it toggles the panel below. #}
<div id="plugin_mydashboard_add_criteria{{ rand }}" style="margin-bottom: 15px;">
    <i class="ti ti-adjustments"></i>
    <span style="font-size: 12px;font-family: verdana,serif;color: #CCC;font-weight: bold;">
        {{ summary_html|raw }}
    </span>
</div>
{{ toggle_script_html|raw }}

<div class="plugin_mydashboard_menuWidget" id="plugin_mydashboard_see_criteria{{ rand }}">
    <form id="{{ form_id }}" action=""
          {%- if on_submit %} onsubmit="{{ refresh_js }} return false;"
          {%- else %} onsubmit="return false;" onchange="{{ refresh_js }}"{% endif %}>
        {{ fields_html|raw }}
        {%- if on_submit %}{{ submit_html|raw }}{% endif %}
    </form>
</div>

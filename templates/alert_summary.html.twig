{# Weather block of the network alerts, also rendered on the login page for anonymous
   visitors (DISPLAY_LOGIN hook): every value is escaped here. #}
{% if css_url %}
    <link rel="stylesheet" type="text/css" href="{{ css_url }}" media="all">
{% endif %}

{% if weather is not null %}
    <div class="card-header mb-4">
        <h2 class="mx-auto">{{ weather.title }}</h2>
    </div>
    <div class="mb-3">
        <i style="color:{{ weather.color }}" class="fas {{ weather.icon_class }} fa-alert-4"></i>
    </div>
    <div class="mb-4 weather_msg">
        {% for item in weather.items %}
            <div>
                <span style="background-color : {{ item.color }}" class="alert_impact"></span>
                <span style="color : {{ item.color }}">
                    {%- if item.url is not null -%}
                        <a href="{{ item.url }}">{{ item.name }}</a>
                    {%- else -%}
                        {{ item.name }}
                    {%- endif -%}
                </span>
            </div>
        {% else %}
            <div class="center">
                <br><br>
                <h3><span class="alert-color">{{ __('No problem detected', 'mydashboard') }}</span></h3>
            </div>
        {% endfor %}
        <br>
    </div>
{% endif %}

{% if show_maintenance %}
    <div class="red bt-col-xs-11 alert-title-div red ">
        {{ __('There is at least on planned scheduled maintenance. Please log on to see more', 'mydashboard') }}
    </div>
{% endif %}

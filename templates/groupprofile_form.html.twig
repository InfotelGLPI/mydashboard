<form method="post" action="{{ form_action }}">
    {{ hidden_html|raw }}
    <table class="tab_cadre_fixe">
        <tr class="tab_bg_1">
            <th colspan="4">{{ __('Default dashboard group', 'mydashboard') }}</th>
        </tr>
        <tr class="tab_bg_1">
            <td>
                {{ checkbox_html|raw }} {{ __('Use profile group', 'mydashboard') }}
            </td>
            <td>{{ __('Default groups', 'mydashboard') }}</td>
            <td>{{ groups_dropdown_html|raw }}</td>
        </tr>
        <tr class="tab_bg_2">
            <td colspan="4" style="text-align:center">{{ submit_html|raw }}</td>
        </tr>
    </table>
    {# closes the <form> above and carries the CSRF token #}
    {{ close_form_html|raw }}

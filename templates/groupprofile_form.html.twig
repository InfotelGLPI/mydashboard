{% import 'components/form/fields_macros.html.twig' as fields %}
{% import 'components/form/basic_inputs_macros.html.twig' as inputs %}

<form method="post" action="{{ form_action }}">
    {{ fields.hiddenField('profiles_id', profiles_id) }}
    {{ fields.csrfField() }}
    <table class="tab_cadre_fixe">
        <tr class="tab_bg_1">
            <th colspan="4">{{ __('Default dashboard group', 'mydashboard') }}</th>
        </tr>
        <tr class="tab_bg_1">
            <td>
                {{ inputs.checkbox('use_group_profile', checked ? 1 : 0) }} {{ __('Use profile group', 'mydashboard') }}
            </td>
            <td>{{ __('Default groups', 'mydashboard') }}</td>
            <td>
                {% do call('Dropdown::showFromArray', ['groups_id', groups, {
                    'multiple': true,
                    'width': '200px',
                    'values': groups_id,
                    'display_emptychoice': true,
                }]) %}
            </td>
        </tr>
        <tr class="tab_bg_2">
            <td colspan="4" class="text-center">
                {{ inputs.submit('addGroup', _x('button', 'Save'), 1, {'class': 'btn btn-primary'}) }}
            </td>
        </tr>
    </table>
</form>

{% extends 'generic_show_form.html.twig' %}
{% import 'components/form/fields_macros.html.twig' as fields %}

{% block form_fields %}
    {{ fields.hiddenField('itemtype', get_class(parent_item)) }}
    {{ fields.hiddenField('items_id', parent_item.getID()) }}

    {% if language_label is not null %}
        {# Updating a translation only allows modifying its value #}
        {{ fields.hiddenField('language', item.fields['language']) }}
        {{ fields.readOnlyField('', language_label, __('Language'), field_options) }}
    {% else %}
        {{ fields.dropdownArrayField('language', session('glpilanguage'), languages, __('Language'), field_options) }}
        {# Reloads the field list with the fields not yet translated in the chosen language #}
        {% do call('Ajax::updateItemOnSelectEvent', [
            'dropdown_language' ~ rand,
            'span_fields' ~ rand,
            fields_url,
            {
                'language': '__VALUE__',
                'itemtype': get_class(parent_item),
                'items_id': parent_item.getID(),
            },
        ]) %}
    {% endif %}

    {% if field_label is not null %}
        {{ fields.hiddenField('field', item.fields['field']) }}
        {{ fields.readOnlyField('', field_label, __('Field'), field_options) }}
    {% else %}
        {% set field_dropdown %}
            {{ fields.dropdownArrayField('field', '', field_choices, '', field_options|merge({
                'used': used_fields,
                'include_field': false,
            })) }}
        {% endset %}
        {{ fields.ajaxField('span_fields' ~ rand, field_dropdown, __('Field'), field_options) }}
    {% endif %}

    {{ fields.textareaField('value', item.fields['value'], __('Value'), field_options|merge({
        'rows': 3,
    })) }}
{% endblock %}

{# form_header_html / form_buttons_html open and close the <form> and its <table> #}
{{ form_header_html|raw }}

<tr class="tab_bg_1">
    <td>{{ __('Language') }}</td>
    <td>
        {{ items_hidden_html|raw }}
        {% if language_label is not null %}
            {{ language_hidden_html|raw }}
            {{ language_label }}
        {% else %}
            {{ language_dropdown_html|raw }}
        {% endif %}
    </td>
    <td colspan="2">&nbsp;</td>
</tr>

<tr class="tab_bg_1">
    <td>{{ __('Field') }}</td>
    <td>
        {% if field_label is not null %}
            {{ field_hidden_html|raw }}
            {{ field_label }}
        {% else %}
            <span id="span_fields" name="span_fields">{{ field_dropdown_html|raw }}</span>
        {% endif %}
    </td>
    <td>{{ __('Value') }}</td>
    <td>{{ value_textarea_html|raw }}</td>
</tr>

{{ form_buttons_html|raw }}

{% set type_labels = {
    'missing_table': __('Missing table', 'mydashboard'),
    'altered_table': __('Altered table', 'mydashboard'),
    'unknown_table': __('Unknown table', 'mydashboard')
} %}
{% set type_colors = {
    'missing_table': 'danger',
    'altered_table': 'warning',
    'unknown_table': 'secondary'
} %}

{% if error is not empty %}
    <div class="alert alert-danger" role="alert">{{ error }}</div>
{% elseif results is empty %}
    <div class="alert alert-success" role="alert">{{ __('The plugin schema is good', 'mydashboard') }}</div>
{% else %}
    <div class="alert alert-info" role="alert">
        {{ __('The queries below are only suggestions built from the differences found. Review them, back up your database, then run them manually: they are never run by the plugin.', 'mydashboard') }}
    </div>

    {% if all_safe is not empty or all_destructive is not empty %}
        <div class="card mb-3">
            <div class="card-header">
                <span class="fw-bold">{{ __('Queries to run', 'mydashboard') }}</span>
            </div>
            <div class="card-body">
                {% if all_safe is not empty %}
                    <pre class="mb-0">{{ all_safe|join("\n\n") }}</pre>
                {% endif %}

                {% if all_destructive is not empty %}
                    <div class="alert alert-warning mt-3" role="alert">
                        {{ __('The following queries remove columns or tables that are not part of the expected schema: data will be lost. Check that they are not used by another plugin or by a custom development before running them.', 'mydashboard') }}
                    </div>
                    <pre class="mb-0">{{ all_destructive|join("\n\n") }}</pre>
                {% endif %}
            </div>
        </div>
    {% endif %}

    {% for result in results %}
        <div class="card mb-3">
            <div class="card-header d-flex align-items-center">
                <span class="fw-bold me-2">{{ result.table }}</span>
                <span class="badge bg-outline-{{ type_colors[result.type]|default('secondary') }}">
                    {{ type_labels[result.type]|default(result.type) }}
                </span>
            </div>
            <div class="card-body">
                <pre class="mb-3">{{ result.diff }}</pre>

                {% if result.safe is not empty %}
                    <div class="fw-bold mb-1">{{ __('Suggested queries', 'mydashboard') }}</div>
                    <pre class="mb-3">{{ result.safe|join("\n\n") }}</pre>
                {% endif %}

                {% if result.destructive is not empty %}
                    <div class="fw-bold mb-1">{{ __('Destructive queries', 'mydashboard') }}</div>
                    <pre class="mb-0">{{ result.destructive|join("\n\n") }}</pre>
                {% endif %}

                {% if result.safe is empty and result.destructive is empty %}
                    <p class="text-muted mb-0">{{ __('No query could be suggested for this difference.', 'mydashboard') }}</p>
                {% endif %}
            </div>
        </div>
    {% endfor %}
{% endif %}

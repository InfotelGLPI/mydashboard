<div class="offcanvas offcanvas-end" tabindex="-1" id="md-widget-offcanvas"
     aria-labelledby="md-wd-oc-label">
    <div class="offcanvas-header border-bottom">
        <h5 class="offcanvas-title" id="md-wd-oc-label">{{ __('Availables widgets', 'mydashboard') }}</h5>
        <button type="button" class="btn-close" data-bs-dismiss="offcanvas"
                aria-label="{{ __('Close') }}"></button>
    </div>
    <div class="offcanvas-body p-2">
        {# Filled by public/lib/md-fuzzysearch.js #}
        <div id="md-fuzzysearch">
            <input type="text" class="md-home-trigger-fuzzy form-control"
                   placeholder="{{ __('Find a widget', 'mydashboard') }}">
            <ul class="results list-group mt-2"></ul>
        </div>
        <div class="mt-2">
            {% if categories is not empty %}
                {{ include('@mydashboard/widgetlist_accordion.html.twig', {
                    'accordion_id': 'md-wd-accordion',
                    'categories': categories,
                }, with_context = false) }}
            {% endif %}
        </div>
    </div>
</div>

{% extends 'generic_show_form.html.twig' %}
{% import 'components/form/fields_macros.html.twig' as fields %}

{% block form_fields %}
    {% set rand = random() %}

    {{ fields.textField(
        'name',
        item.fields['name'],
        __('Name'),
        field_options
    ) }}

    {% if itemtype_label is not null %}
        {{ fields.readOnlyField(
            '',
            itemtype_label,
            __('Item type'),
            field_options
        ) }}
        {{ fields.hiddenField('itemtype', item.fields['itemtype']) }}
    {% else %}
        {{ fields.dropdownItemTypes(
            'itemtype',
            item.fields['itemtype'],
            __('Item type'),
            field_options|merge({
                'types': itemtypes,
                'rand': rand,
                'required': item.isNewItem(),
            })
        ) }}
        {# The types and statuses offered depend on the chosen item type #}
        {% for target, endpoint in {'show_types': 'dropdownType.php', 'show_statuses': 'dropdownStatus.php'} %}
            {% do call('Ajax::updateItemOnSelectEvent', [
                'dropdown_itemtype' ~ rand,
                target ~ rand,
                ajax_url ~ endpoint,
                {'itemtype': '__VALUE__', 'fieldname': 'types'}
            ]) %}
        {% endfor %}
    {% endif %}

    {% set types_field %}
        {% if types is not null %}
            {{ fields.dropdownArrayField(
                'types',
                null,
                types,
                '',
                field_options|merge({
                    'multiple': true,
                    'values': selected_types,
                    'include_field': false,
                })
            ) }}
        {% endif %}
    {% endset %}
    {{ fields.ajaxField('show_types' ~ rand, types_field, __('Type'), field_options) }}

    {% set states_field %}
        {% if states is not null %}
            {{ fields.dropdownArrayField(
                'states',
                null,
                states,
                '',
                field_options|merge({
                    'multiple': true,
                    'values': selected_states,
                    'include_field': false,
                })
            ) }}
        {% endif %}
    {% endset %}
    {{ fields.ajaxField('show_statuses' ~ rand, states_field, __('Item state'), field_options) }}

    {{ fields.dropdownWebIcons(
        'icon',
        item.fields['icon'],
        __('Icon'),
        field_options
    ) }}

    {{ fields.dropdownNumberField(
        'alarm_threshold',
        item.fields['alarm_threshold'],
        __('Alert threshold'),
        field_options|merge({
            'min': 1,
            'max': 100,
            'step': 1,
        })
    ) }}
{% endblock %}

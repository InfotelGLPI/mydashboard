{# form_header_html / form_buttons_html open and close the <form> and its <table> #}
{{ form_header_html|raw }}

<tr class="tab_bg_1">
    <td>{{ __('Name') }}</td>
    <td>{{ name_input_html|raw }}</td>
    <td>
        {{ __('Item type') }}
        {%- if is_new %} <span class="red">*</span>{% endif %}
    </td>
    <td>
        {% if itemtype_label is not null %}
            {{ itemtype_label }}
            {{ itemtype_hidden_html|raw }}
        {% else %}
            {{ itemtype_dropdown_html|raw }}
        {% endif %}
    </td>
</tr>

<tr class="tab_bg_1">
    <td>{{ __('Type') }}</td>
    <td><span id="show_types{{ rand }}">{{ types_dropdown_html|raw }}</span></td>
    <td>{{ __('Item state') }}</td>
    <td><span id="show_statuses{{ rand }}">{{ states_dropdown_html|raw }}</span></td>
</tr>

<tr class="tab_bg_1">
    <td>{{ __('Icon') }}</td>
    <td>{{ icon_select_html|raw }}</td>
    <td>{{ __('Alert threshold') }}</td>
    <td>{{ threshold_dropdown_html|raw }}</td>
</tr>

{{ form_buttons_html|raw }}

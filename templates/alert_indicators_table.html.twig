<table id="indicators" class="indicators">
    <tr>
        {% for cell in cells %}
            <td class="{{ cell.class }}">
                <a style="{{ cell.link.style }}" title="{{ cell.link.title }}" href="{{ cell.link.url }}">
                    <span>{{ cell.link.count }}</span>
                </a>
            </td>
        {% endfor %}
    </tr>
</table>

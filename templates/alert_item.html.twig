{% if create_button is not null %}
    <table class="tab_cadre_fixe">
        <tr>
            <th>{{ create_button.menu_name }}</th>
        </tr>
        <tr class="tab_bg_1">
            <td class="center">
                <button type="button" class="submit btn btn-primary" data-md-create-alert
                        data-url="{{ create_button.url }}"
                        data-itemtype="{{ create_button.itemtype }}"
                        data-items-id="{{ create_button.items_id }}"
                        data-confirm="{{ __('Create a new alert', 'mydashboard') }}">
                    {{- __('Create a new alert', 'mydashboard') -}}
                </button>
            </td>
        </tr>
    </table>
    <script type="module" src="{{ create_button.script_url }}"></script>
{% endif %}

{% if reminder is not null %}
    <table class="tab_cadre_fixe">
        <tr>
            <th colspan="2">{{ __('Linked reminder', 'mydashboard') }}</th>
        </tr>
        <tr class="tab_bg_2">
            <td>{{ __('Name') }}</td>
            {# Reminder::getLink() escapes the name #}
            <td>{{ reminder.link_html|raw }}</td>
        </tr>
        <tr class="tab_bg_2">
            <td>{{ __('Comment') }}</td>
            {# text already run through RichText::getSafeHtml() in the controller #}
            <td>{{ reminder.text_html|raw }}</td>
        </tr>
    </table>

    {# rendered by alert_form.html.twig (auto-escaped, no raw fragment) #}
    {{ alert_form_html|raw }}
{% endif %}

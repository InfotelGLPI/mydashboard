{% import 'components/form/fields_macros.html.twig' as fields %}
{% import 'components/form/basic_inputs_macros.html.twig' as inputs %}

<div class="firstbloc">
    {% if openform %}
        <form method="post" action="{{ form_action }}">
    {% endif %}

    <table class="tab_cadre_fixe">
        <tr class="tab_bg_1">
            <th>{{ name }}</th>
        </tr>
        <tr class="tab_bg_1">
            <td>
                {#
                 # Html::textarea() rather than inputs.textarea(): the macro would run the
                 # value through |safe_html, which rewrites the encoded markup edited here.
                 #}
                {% do call('Html::textarea', [{
                    'name': 'content',
                    'value': content,
                    'editor_id': 'custom_css_code_' ~ rand,
                    'rand': rand,
                    'enable_richtext': true,
                }]) %}
            </td>
        </tr>
        {% if closeform %}
            <tr class="tab_bg_1 center">
                <td>
                    {{ fields.hiddenField('id', id) }}
                    {{ inputs.submit('update', _x('button', 'Save'), 1, {'class': 'btn btn-primary'}) }}
                </td>
            </tr>
        {% endif %}
    </table>

    {% if closeform %}
        </form>
    {% endif %}
</div>

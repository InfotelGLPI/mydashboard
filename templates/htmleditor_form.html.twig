<div class="firstbloc">
    {% if openform %}
        <form method="post" action="{{ form_action }}">
    {% endif %}

    <table class="tab_cadre_fixe">
        <tr class="tab_bg_1">
            <th>{{ name }}</th>
        </tr>
        <tr class="tab_bg_1">
            <td>{{ textarea_html|raw }}</td>
        </tr>
        {% if closeform %}
            <tr class="tab_bg_1 center">
                <td>
                    {{ hidden_html|raw }}
                    {{ submit_html|raw }}
                </td>
            </tr>
        {% endif %}
    </table>

    {% if closeform %}
        {# closes the <form> above and carries the CSRF token #}
        {{ close_form_html|raw }}
    {% endif %}
</div>

{# The mode selector is not wrapped with Criteria::getFieldHtml(): the legacy markup puts
   no separator between it and the block below, which the AJAX call refreshes in place. #}
<span class="md-widgetcrit">{{ __('Filter date', 'mydashboard') }}&nbsp;{{ mode_html|raw }}</span>

{% if begin_end %}
    <span id="filter_date_crit{{ rand }}" name="filter_date_crit{{ rand }}" class="md-widgetcrit">
        <span class="md-widgetcrit">{{ __('Start') }}&nbsp;{{ begin_html|raw }}</span>
        <br>
        <span class="md-widgetcrit">{{ __('End') }}&nbsp;{{ end_html|raw }}</span>
    </span>
{% else %}
    <br><br>
    <span id="filter_date_crit{{ rand }}" name="filter_date_crit{{ rand }}" class="md-widgetcrit">
        {{ __('Year', 'mydashboard') }}&nbsp;{{ year_html|raw }}
    </span>
{% endif %}

{{ ajax_html|raw }}
{%- if count > 1 %}<br><br>{% endif -%}

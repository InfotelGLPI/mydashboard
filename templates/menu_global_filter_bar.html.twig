<div id="md-global-filter-bar"
     class="d-flex flex-wrap align-items-center gap-2 p-2 mb-2 bg-light border-bottom rounded-1">
    <span class="badge bg-outline-secondary">
        <i class="ti ti-filter me-1"></i>{{ __('Global filter', 'mydashboard') }}
    </span>

    {% for filter in filters %}
        <div class="d-flex align-items-center gap-1">
            <label class="form-label mb-0 text-muted small me-1">{{ filter.label }}</label>
            {{ filter.input_html|raw }}
        </div>
    {% endfor %}

    {{ change_script_html|raw }}
</div>

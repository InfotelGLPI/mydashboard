<form action="{{ form_action }}" method="post">
    <table class="tab_cadre_fixe">
        <tr>
            <th colspan="2">{{ _n('Alert', 'Alerts', 2, 'mydashboard') }}</th>
        </tr>
        <tr class="tab_bg_2">
            <td>{{ __('Type') }}</td>
            <td>{{ type_html|raw }}</td>
        </tr>
        <tr class="tab_bg_2">
            <td>{{ __('Alert level', 'mydashboard') }}</td>
            <td>{{ impact_html|raw }}</td>
        </tr>
        <tr class="tab_bg_2">
            <td>{{ __('Linked with a ticket category', 'mydashboard') }}</td>
            <td>{{ category_html|raw }}</td>
        </tr>
        <tr class="tab_bg_2">
            <td>{{ __('Public') }}</td>
            <td>{{ public_html|raw }}</td>
        </tr>
        {% if can_edit %}
            <tr class="tab_bg_1 center">
                <td colspan="2">
                    {{ submit_html|raw }}
                    {{ hidden_html|raw }}
                </td>
            </tr>
        {% endif %}
    </table>
    {# closes the <form> above and carries the CSRF token #}
    {{ close_form_html|raw }}

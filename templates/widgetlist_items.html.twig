{# Recursive: a leaf is an "add widget" button, a folder nests another list. #}
{% for item in items %}
    {% if item.kind == 'button' %}
        <button type="button" id="btnAddWidgete{{ item.widget_id }}"
                class="list-group-item list-group-item-action plugin_mydashboard_menuDashboardListItem"
                data-widgetid="{{ item.gsid }}" data-classname="{{ item.classname }}">
            {%- if item.icon %}<i class="{{ item.icon }} me-1"></i>{% endif -%}
            {{ item.label }}{{ item.debug }}
            {%- if item.comment %}<br><small class="text-muted">{{ item.comment }}</small>{% endif -%}
        </button>
    {% else %}
        <div class="ps-3 border-start ms-2 mt-1">
            <div class="small text-muted py-1">
                <i class="ti ti-folder me-1"></i>{{ item.label }}
            </div>
            <div class="list-group list-group-flush">
                {% include '@mydashboard/widgetlist_items.html.twig' with {'items': item.items} only %}
            </div>
        </div>
    {% endif %}
{% endfor %}

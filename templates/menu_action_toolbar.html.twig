{# Viewing-mode toolbar. Each action is a plain anchor picked up by the dashboard JS
   through its id; "ms_auto" pushes the action to the right of the bar. #}
<div class="md-edit-toolbar d-flex flex-wrap align-items-center gap-2 p-2 mb-3 border rounded-2">
    <span class="badge bg-outline-secondary">
        <i class="ti ti-layout-dashboard me-1"></i>{{ __('My Dashboard', 'mydashboard') }}
    </span>

    <div class="vr mx-1"></div>

    {% for action in actions %}
        <a id="{{ action.id }}" role="button" style="padding: 5px;"
           class="btn {{ action.class }} btn-sm{{ action.ms_auto is defined and action.ms_auto ? ' ms-auto' : '' }}">
            <i class="{{ action.icon }} me-1"></i>{{ action.label }}
        </a>
    {% endfor %}
</div>

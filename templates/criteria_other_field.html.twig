{# Like criteria_field, but the trailing spacing varies per criterion in Criterias\Other:
   "single" when another field follows on the next line, "double" otherwise. #}
<span class="md-widgetcrit">
    {%- if label is not empty %}{{ label }}&nbsp;{% endif -%}
    {{ input_html|raw }}
    {%- if extra_html is not empty %}{{ extra_html|raw }}{% endif -%}
</span>
{%- if break == 'double' %}<br><br>{% elseif break == 'single' %}<br>{% endif -%}

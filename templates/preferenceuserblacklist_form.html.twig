{% import 'components/form/fields_macros.html.twig' as fields %}
{% import 'components/form/basic_inputs_macros.html.twig' as inputs %}

<form method="post" action="{{ form_action }}">
    {{ fields.hiddenField('id', user_id) }}
    <table class="tab_cadre_fixe">
        <tr class="headerRow">
            <th class="center" colspan="2">
                {{ __('From which plugins you want to display the widgets?', 'mydashboard') }}
            </th>
        </tr>
        {% for row in rows %}
            <tr class="tab_bg_1">
                <td>{{ row.label }}</td>
                <td>{% do call('Dropdown::showYesNo', [row.name, row.value]) %}</td>
            </tr>
        {% endfor %}
        <tr class="tab_bg_2">
            <td class="center" colspan="2">
                {{ inputs.submit('update', _x('button', 'Save'), 1, {'class': 'btn btn-primary'}) }}
            </td>
        </tr>
    </table>
</form>

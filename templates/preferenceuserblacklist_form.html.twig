<form method="post" action="{{ form_action }}" onsubmit="return true;">
    <table class="tab_cadre_fixe">
        <tr class="headerRow">
            <th class="center" colspan="2">
                {{ __('From which plugins you want to display the widgets?', 'mydashboard') }}
            </th>
        </tr>
        {% for row in rows %}
            <tr class="tab_bg_1">
                <td>{{ row.label }}</td>
                <td>{{ row.yesno_html|raw }}</td>
            </tr>
        {% endfor %}
        <tr class="tab_bg_2">
            <td class="center" colspan="2">
                {{ submit_html|raw }}
                {{ hidden_html|raw }}
            </td>
        </tr>
    </table>
    {# closes the <form> above and carries the CSRF token #}
    {{ close_form_html|raw }}

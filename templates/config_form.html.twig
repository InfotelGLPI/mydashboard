{# form_header_html / form_buttons_html open and close the <form> and its <table> #}
{{ form_header_html|raw }}

<tr class="tab_bg_1">
    <td>{{ __('Enable the possibility to display Dashboard in full screen', 'mydashboard') }}</td>
    <td>
        {%- if can_create -%}
            {{ fullscreen_html|raw }}
        {%- else -%}
            {{ fullscreen_label }}
        {%- endif -%}
    </td>
</tr>

<tr class="tab_bg_1">
    <td>{{ __('Replace central interface', 'mydashboard') }}</td>
    <td>{{ replace_central_html|raw }}</td>
</tr>

<tr class="tab_bg_2">
    <td>{{ __('Impact colors for alerts', 'mydashboard') }}</td>
    <td colspan="3">
        <table>
            <tr>
                {% for color in impact_colors %}
                    <td>
                        <label for="dropdown_priority_{{ color.level }}{{ rand }}">{{ color.level }}</label>&nbsp;
                        {{ color.field_html|raw }}
                    </td>
                {% endfor %}
            </tr>
        </table>
    </td>
</tr>

<tr class="tab_bg_1">
    <td>{{ __('Level of categories to show', 'mydashboard') }}</td>
    <td>{{ level_cat_html|raw }}</td>
</tr>

<tr class="tab_bg_1">
    <td>{{ __('Title of alerts widget', 'mydashboard') }}</td>
    <td>{{ title_alerts_html|raw }}</td>
</tr>

<tr class="tab_bg_1">
    <td>{{ __('Title of scheduled maintenances widget', 'mydashboard') }}</td>
    <td>{{ title_maintenances_html|raw }}</td>
</tr>

<tr class="tab_bg_1">
    <td>{{ __('Title of informations widget', 'mydashboard') }}</td>
    <td>{{ title_informations_html|raw }}</td>
</tr>

<tr class="tab_bg_1">
    <td colspan="2">
        {{ reconstruct_backlog_html|raw }}&nbsp;{{ reconstruct_indicators_html|raw }}
        <br><br>
        <div class="alert alert-warning d-flex">
            {{ __('Can take many time if you have many tickets', 'mydashboard') }}
        </div>
    </td>
</tr>

{{ form_buttons_html|raw }}

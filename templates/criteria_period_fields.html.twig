{# Start/end month and year grid. Shared by Criterias\DisplayData and the AJAX endpoint
   that refreshes this very block, so the two cannot drift apart. #}
<span id="display_data_crit{{ rand }}" name="display_data_crit{{ rand }}" class="md-widgetcrit">
    {% for field in fields %}
        <span class="md-widgetcrit">
            {%- for i in 1..(field.breaks ?? 0) %}<br>{% endfor -%}
            {{ field.label }}&nbsp;{{ field.input_html|raw }}
        </span>
    {% endfor %}
</span>

{% import 'components/form/fields_macros.html.twig' as fields %}
{% import 'components/form/basic_inputs_macros.html.twig' as inputs %}

{# "Authorize/Unauthorize all": handled by public/scripts/authorized-widgets.js #}
<form method="post" action="{{ form_action }}">
    {{ fields.hiddenField('id', profiles_id) }}
    <table class="tab_cadre_fixe">
        <tr class="tab_bg_2">
            <th colspan="2" class="center b">{{ __('Authorized widgets', 'mydashboard') }}</th>
        </tr>
        {% for plugin in plugins %}
            <tr class="tab_bg_2" style="background-color: #CCC;">
                <td>{{ plugin.label }}</td>
                <td class="plugin_mydashboard_authorize_all" data-md-toggle-all="{{ plugin.css_class }}">
                    {{- __('Authorize/Unauthorize all', 'mydashboard') }}&nbsp;
                </td>
            </tr>
            {% for widget in plugin.widgets %}
                <tr class="tab_bg_1 {{ plugin.css_class }}">
                    <td class="{{ widget.authorized ? 'plugin_mydashboard_authorized' : 'plugin_mydashboard_unauthorized' }}">
                        {{ widget.title }}
                        {%- if widget.category %}
                            <span class="plugin_mydashboard_discret" style="color:gray">&nbsp;&nbsp;{{ widget.category }}</span>
                        {%- endif %}
                    </td>
                    <td>{% do call('Dropdown::showYesNo', [widget.name, widget.authorized ? 1 : 0]) %}</td>
                </tr>
            {% endfor %}
        {% endfor %}
        <tr class="tab_bg_2">
            <td class="center" colspan="2">
                {{ inputs.submit('update', _x('button', 'Save'), 1, {'class': 'btn btn-primary'}) }}
            </td>
        </tr>
    </table>
</form>
<script type="module" src="{{ script_url }}"></script>

{# Rendered empty when the mode is not MONTH: the span must exist either way, since the
   AJAX call targets it by id to fill it in. #}
<span id="month_crit{{ rand }}" name="month_crit{{ rand }}" class="md-widgetcrit">
    {%- if show_month -%}
        {{ include('@mydashboard/criteria_period_month.html.twig', {'name': name, 'months': months, 'value': value}, with_context = false) }}
    {%- endif -%}
</span>
{# Refills the span above whenever another period is picked in the observed dropdown #}
{% do call('Ajax::updateItemOnSelectEvent', [observed, 'month_crit' ~ rand, url, {'value': '__VALUE__'}]) %}

{# Criteria bar of a widget, and the container the chart library draws into. #}
<div class="bt-row">
    <div class="{{ export ? 'bt-col-md-8' : 'bt-col-md-12' }} left">
        {{ criteria_html|raw }}
    </div>

    {% if canvas %}
        {% if no_results %}
            <div class="center">
                <br><br>
                <h3><span class="maint-color">{{ __('No results found') }}</span></h3>
            </div>
        {% endif %}
        <div id="chart-container" class="chart-container">
            <div id="{{ name }}" style="width: 100%; height: 400px;"></div>
        </div>
    {% endif %}
</div>

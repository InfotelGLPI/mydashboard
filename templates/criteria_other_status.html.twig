{# Two-column checkbox grid of ticket statuses. Each checkbox is preceded by a hidden
   input so an unchecked box still posts a value. #}
<span class="md-widgetcrit">
    {{- _n('Status', 'Statuses', 2) }}&nbsp;
    {% for status in statuses %}
        <input type="hidden" name="status_{{ status.value }}" value="0" />
        <input type="checkbox" name="status_{{ status.value }}" value="1"
               {%- if status.checked %} checked="checked"{% endif %} />
        {{ status.label }}
        {%- if loop.index is even %}<br>{% else %}&nbsp;{% endif -%}
    {% endfor %}
</span>
{%- if count > 1 %}<br><br>{% endif -%}

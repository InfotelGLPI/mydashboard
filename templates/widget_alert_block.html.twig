{# Shared frame of the alert / maintenance / information widgets: only the grid id,
   the bootstrap alert flavour, the title field and the empty wording differ. #}
{% if hidewidget %}
    <div class="card" id="gridcontent{{ gs_id }}">
{% endif %}

<div id="{{ gs_id }}" class="bt-row {{ addclass }}" style="{{ style }}">
    <div class="bt-feature {{ feature_class }} ">
        <{{ heading }}>
            {# title_html comes from Config::displayField() #}
            <div class="alert {{ alert_class }} " role="alert">{{ title_html|raw }}</div>
        </{{ heading }}>

        <div id="display-sc">
            {% if list_html is not empty %}
                {{ list_html|raw }}
            {% else %}
                <div class="center">
                    <{{ heading }}>
                        <span class="alert-color">{{ empty_label }}</span>
                    </{{ heading }}>
                </div>
            {% endif %}
        </div>
    </div>
</div>

{% if hidewidget %}
    </div>
{% endif %}
